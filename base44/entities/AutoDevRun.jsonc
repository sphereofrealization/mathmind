{
  "name": "AutoDevRun",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "completed",
        "error"
      ],
      "default": "queued"
    },
    "idea_summaries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "agent_id",
    "status"
  ]
}